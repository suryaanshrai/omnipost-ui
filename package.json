    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
